# BayiOS production environment — copy to .env and change the values.
# compose.yaml reads these automatically from the project directory.

# REQUIRED: PostgreSQL password. Used both by the postgres service and to build
# the app's DATABASE_URL. Use a long random value; never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# REQUIRED (MVP auth): shared staff password.
# At least 8 characters, at least one letter and one digit; special characters
# are optional. Common values (password, 12345678, ...) are rejected.
# Avoid #, $, quotes and leading/trailing spaces: they break .env parsing.
# If this is empty, the app refuses to start (fail-closed).
BAYIOS_ADMIN_PASSWORD=

# REQUIRED (MVP auth): session cookie signing key, at least 32 random characters.
# Generate on the server:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs out every device (emergency kill switch).
BAYIOS_SESSION_SECRET=

# Port the app publishes on the LAN interface.
BAYIOS_PORT=8000

# Logging (console is human-readable; json is structured).
BAYIOS_LOG_LEVEL=INFO
BAYIOS_LOG_FORMAT=console

# Optional auth tuning (defaults shown; uncomment only to change):
# BAYIOS_SESSION_TTL_HOURS=12
# BAYIOS_REMEMBER_TTL_DAYS=30
# BAYIOS_LOGIN_MAX_ATTEMPTS=10
# BAYIOS_LOGIN_LOCKOUT_MINUTES=5
# BAYIOS_LOGIN_EXEMPT_IPS=127.0.0.1,::1
# (Add the server's own LAN IP only if you browse from the server via that IP.)
# BAYIOS_COOKIE_SECURE=false
