# BayiOS production environment — copy to `.env` and change the values.
# `compose.yaml` reads these automatically from the project directory.

# REQUIRED: PostgreSQL password. Used both by the postgres service and to build
# the app's DATABASE_URL. Use a long random value; never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Port the app publishes on the LAN interface.
BAYIOS_PORT=8000

# Logging (console is human-readable; json is structured).
BAYIOS_LOG_LEVEL=INFO
BAYIOS_LOG_FORMAT=console
