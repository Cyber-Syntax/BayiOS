DATABASE_URL=postgresql+psycopg://bayios:bayios@127.0.0.1:5432/bayios
# Only used by the `bayios` script. With `uvicorn --host ...` pass the host on the CLI.
BAYIOS_HOST=127.0.0.1
BAYIOS_PORT=8000
BAYIOS_LOG_LEVEL=INFO
BAYIOS_LOG_FORMAT=console

# --- MVP auth (shared password) ---
# REQUIRED after the auth update. Copy this file to .env and fill both values;
# the app refuses to start while they are empty or invalid (fail-closed).
#
# Password: at least 8 characters, at least one letter and one digit.
# Special characters are optional. Common values (password, 12345678, ...) are
# rejected. Keep it easy for staff to type; e.g. mavi-kedi-42 (example only).
# Avoid #, $, quotes and leading/trailing spaces: they break .env parsing.
BAYIOS_ADMIN_PASSWORD=
#
# Session signing key: at least 32 random characters. Changing it logs out
# every device (emergency kill switch).
# Generate on the server:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BAYIOS_SESSION_SECRET=
#
# Optional tuning (defaults shown; uncomment only to change):
# BAYIOS_SESSION_TTL_HOURS=12
# BAYIOS_REMEMBER_TTL_DAYS=30
# BAYIOS_LOGIN_MAX_ATTEMPTS=10
# BAYIOS_LOGIN_LOCKOUT_MINUTES=5
# BAYIOS_LOGIN_EXEMPT_IPS=127.0.0.1,::1
# (Add the server's own LAN IP only if you browse from the server via that IP.)
# BAYIOS_COOKIE_SECURE=false
#
# Manual setup and troubleshooting (Turkish):
# docs/auth-mvp-plan.md §8.1 and §8.4, docs/OPERATIONS.md
